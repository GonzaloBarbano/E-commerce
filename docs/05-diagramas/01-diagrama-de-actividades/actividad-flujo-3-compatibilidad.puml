@startuml flujo-3-compatibilidad
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333

|Usuario|
start
:Selecciona componentes (CPU, MB, RAM, PSU);
:Solicita validación;

|Sistema|
:Identificar IDs de componentes;

|Base de Datos|
:Consultar especificaciones técnicas (Specs);
:Retornar datos técnicos detallados;

|Sistema|
:Inicializa lista de errores;
repeat
  :Tomar siguiente regla de validación;
  if (¿Validar Socket?) then (sí)
    if (¿Socket CPU == Motherboard?) then (no)
      :Agregar "Socket incompatible";
    endif
  elseif (¿Validar RAM?) then (sí)
    if (¿Tipo RAM (DDR) compatible?) then (no)
      :Agregar "RAM incompatible";
    endif
  elseif (¿Validar PSU?) then (sí)
    :Calcular consumo total;
    if (¿Potencia suficiente?) then (no)
      :Agregar "PSU insuficiente";
    endif
  else (Espacio)
    if (¿Refrigerador cabe en Case?) then (no)
      :Agregar "Tamaño excedido";
    endif
  endif
repeat while (¿Quedan reglas por validar?) is (sí)

if (¿Lista de errores vacía?) then (sí)
  :Generar reporte: COMPATIBLE;
else (no)
  :Generar reporte: INCOMPATIBLE;
endif

|Usuario|
:Visualiza el reporte detallado;
stop
@enduml
